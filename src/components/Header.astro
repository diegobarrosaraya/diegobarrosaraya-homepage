---
import ThemeToggle from './ThemeToggle.astro';
export interface Props { current?: 'work' | 'records' | 'notes' | 'resume' | 'contact' }
const { current } = Astro.props;
const nav = [
  { id: 'work', label: 'Work', href: '/#work' },
  { id: 'records', label: 'Service records', href: '/#records' },
  { id: 'notes', label: 'Notes', href: '/#parts' },
  { id: 'resume', label: 'Resume', href: '/resume/' },
  { id: 'contact', label: 'Contact', href: '/contact/' },
] as const;
---
<header class="top">
  <a class="name" href="/">Diego Barros Araya</a>
  <nav aria-label="Sections">
    {nav.map((i) => (
      <a href={i.href} aria-current={current === i.id ? 'page' : undefined}>{i.label}</a>
    ))}
  </nav>
  <ThemeToggle />
</header>

<style>
  header.top {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px;
    padding: 22px 0 14px; border-bottom: 3px double var(--rule);
  }
  .name {
    font: 400 18px/1.2 var(--font-head); letter-spacing: .02em;
    color: var(--ink); text-decoration: none;
  }
  nav { margin-left: auto; display: flex; flex-wrap: wrap; gap: 6px 22px; }
  nav a { text-decoration: none; color: var(--steel); }
  nav a:hover { text-decoration: underline; }
  nav a[aria-current="page"] { color: var(--active-text); filter: var(--glow); }
  @media (max-width: 880px) { nav { margin-left: 0; width: 100%; } }
</style>
