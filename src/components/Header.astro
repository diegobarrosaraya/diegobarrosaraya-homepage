---
import ThemeToggle from './ThemeToggle.astro';
import { noteFileCount } from '../lib/notes/note-files';
export interface Props { current?: 'work' | 'how' | 'notes' | 'resume' | 'contact' }
const { current } = Astro.props;
// The Notes item shows only when the build has notes, the same count the sitemap uses.
const nav = [
  { id: 'work', label: 'Work', href: '/#work' },
  { id: 'how', label: 'How I work', href: '/#how' },
  ...(noteFileCount() > 0 ? [{ id: 'notes', label: 'Notes', href: '/notes/' }] : []),
  { id: 'resume', label: 'Resume', href: '/resume/' },
  { id: 'contact', label: 'Contact', href: '/contact/' },
];
---
<header class="top">
  <a class="name" href="/">Diego Barros Araya</a>
  <nav aria-label="Sections">
    {nav.map((i) => (
      <a href={i.href} aria-current={current === i.id ? 'page' : undefined}>{i.label}</a>
    ))}
  </nav>
  <ThemeToggle />
</header>

<style>
  header.top {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px;
    padding: 22px 0 14px; border-bottom: 3px double var(--rule);
  }
  .name {
    font: expanded var(--head-weight) 18px/1.2 var(--font-head); letter-spacing: .02em;
    color: var(--ink); text-decoration: none;
  }
  nav { margin-left: auto; display: flex; flex-wrap: wrap; gap: 6px 22px; }
  nav a { text-decoration: none; color: var(--steel); }
  nav a:hover { text-decoration: underline; }
  nav a[aria-current="page"] { color: var(--active-text); filter: var(--glow); }
  /* Small phones: tighter gaps keep five items on one line. */
  @media (max-width: 560px) { nav { column-gap: 14px; } }
  /* Phones: the toggle shares the name line, the nav takes the row below. */
  @media (max-width: 880px) {
    nav { margin-left: 0; width: 100%; order: 1; }
    header.top :global(.theme) { margin-left: auto; }
  }
</style>
