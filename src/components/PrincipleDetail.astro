---
import { fade } from 'astro:transitions';
import { PRINCIPLES, caseBySlug, type Principle } from '../data/story';
export interface Props { principle: Principle }
const { principle } = Astro.props;
const i = PRINCIPLES.findIndex((p) => p.slug === principle.slug);
const prev = PRINCIPLES[(i + PRINCIPLES.length - 1) % PRINCIPLES.length];
const next = PRINCIPLES[(i + 1) % PRINCIPLES.length];
const proof = principle.proof === 'team' ? [] : principle.proof.map((slug) => caseBySlug(slug)!);
---
<div class="detail" transition:name="detail" transition:animate={fade({ duration: '450ms' })}>
  <a class="back" href="/">
    <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 7H2M6 3 2 7l4 4" /></svg>
    Full movement</a>
  <h1>{principle.sentence}</h1>
  <p class="lede">{principle.explain}</p>
  <h2>Where it shows</h2>
  {principle.proof === 'team' ? (
    <p class="team"><a href="/#team">How I work with my team</a></p>
  ) : (
    <ul>
      {proof.map((c) => (
        <li><a href={`/work/${c.slug}/`}>{c.name}</a><p>{c.summary}</p></li>
      ))}
    </ul>
  )}
  <nav class="nextprev" aria-label="Other principles">
    <a href={`/how/${prev.slug}/`}>
      <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 7H2M6 3 2 7l4 4" /></svg>
      {prev.sentence}</a>
    <a href={`/how/${next.slug}/`}>{next.sentence}
      <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" /></svg></a>
  </nav>
</div>

<style>
  .back {
    color: var(--steel); font: 600 15px/1 var(--font-label);
    display: inline-flex; gap: 8px; align-items: center; margin-bottom: 22px;
  }
  h1 { font: expanded var(--head-weight) clamp(23px, 2.5vw, 34px)/1.25 var(--font-head); margin: 6px 0 10px; text-wrap: balance; }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0 0 22px; max-width: 46ch; }
  h2 { font: 600 17px/1.3 var(--font-label); margin: 0 0 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--hair); padding: 14px 0; }
  li:last-child { border-bottom: 1px solid var(--hair); }
  li a { font-weight: 600; }
  li p { margin: 4px 0 0; color: var(--ink-2); }
  .team { margin: 0; }
  .nextprev { display: flex; justify-content: space-between; gap: 16px; margin-top: 20px; }
  .nextprev a { display: inline-flex; gap: 8px; align-items: center; }
  .nextprev a:last-child { text-align: right; }
</style>
