---
// Copy from the approved mockup.
const rows = [
  ['Function', 'Integrations, automation and platforms that hold up in production'],
  ['Tolerance', 'Works inside contract, security and platform limits, and says so when a limit is unclear'],
  ['Regulation', 'Verified before shipped: tests, gates that fail closed, a rollback plan'],
  ['Base', 'Santiago, Chile · remote · English and Spanish'],
];
---
<table class="spec-table" aria-label="Specification">
  {rows.map(([k, v]) => <tr><th class="label" scope="row">{k}</th><td>{v}</td></tr>)}
</table>

<style>
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; vertical-align: top; padding: 10px 0; border-top: 1px solid var(--hair); }
  th { width: 9.5em; padding-right: 14px; color: var(--ink-2); line-height: 1.55; }
  tr:last-child th, tr:last-child td { border-bottom: 1px solid var(--hair); }
</style>
