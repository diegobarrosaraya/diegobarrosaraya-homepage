<button class="theme" id="theme" type="button">LCD view</button>

<script>
  import { writeTheme } from '../lib/theme';

  const root = document.documentElement;
  // Dark (the dial) is the default for everyone; only a saved or clicked choice switches to the LCD.
  const dark = () => root.dataset.theme !== 'light';

  // The label names the view the button switches to, so it follows the effective theme.
  function sync() {
    const btn = document.getElementById('theme');
    if (btn) btn.textContent = dark() ? 'LCD view' : 'Dial view';
  }
  function bind() {
    const btn = document.getElementById('theme');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const next = dark() ? 'light' : 'dark';
      root.dataset.theme = next;
      writeTheme(localStorage, next);
      sync();
    });
  }
  function init() { bind(); sync(); }

  init();
  // ClientRouter replaces the root attributes on swap: carry the current theme into the new
  // document so it survives navigation even when localStorage is blocked.
  document.addEventListener('astro:before-swap', (e) => {
    const t = root.dataset.theme;
    if (t) e.newDocument.documentElement.dataset.theme = t;
  });
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .theme {
    font: 500 14px/1 var(--font-label);
    background: none; border: 1px solid var(--hair); color: var(--ink); padding: 7px 10px; cursor: pointer;
  }
  .theme:hover { border-color: var(--steel); color: var(--steel); }
</style>
