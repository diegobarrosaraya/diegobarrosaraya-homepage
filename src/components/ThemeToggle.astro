<button class="theme" id="theme" type="button" aria-pressed="false">Lume view</button>

<script>
  import { readTheme, writeTheme } from '../lib/theme';

  const root = document.documentElement;
  const dark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;

  function sync() {
    document.getElementById('theme')?.setAttribute('aria-pressed', String(dark()));
  }
  function bind() {
    const btn = document.getElementById('theme');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const next = dark() ? 'light' : 'dark';
      root.dataset.theme = next;
      writeTheme(localStorage, next);
      sync();
    });
  }
  function init() { bind(); sync(); }

  init();
  // ClientRouter swaps the document: restore the saved theme on the new root
  document.addEventListener('astro:after-swap', () => {
    const t = readTheme(localStorage);
    if (t) root.dataset.theme = t;
  });
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .theme {
    font: 600 13px/1 var(--font-label); letter-spacing: .09em; text-transform: uppercase;
    background: none; border: 1px solid var(--hair); color: var(--ink); padding: 7px 10px; cursor: pointer;
  }
  .theme:hover { border-color: var(--steel); color: var(--steel); }
  .theme[aria-pressed="true"] { border-color: var(--steel); color: var(--steel); }
</style>
