---
import { CASES } from '../data/story';

// The four main case studies get full rows; this site closes the list as a short row.
const main = CASES.filter((c) => c.slug !== 'this-site');
const site = CASES.find((c) => c.slug === 'this-site')!;
---
<ul class="cases">
  {main.map((c) => (
    <li>
      <a href={`/work/${c.slug}/`}>
        <span class="name">{c.name}</span>
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" /></svg>
      </a>
      <p>{c.summary}</p>
    </li>
  ))}
  <li class="site">
    <a href={`/work/${site.slug}/`}>{site.name}
      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" /></svg></a>
    <p>{site.summary}</p>
  </li>
</ul>

<style>
  .cases { list-style: none; margin: 0; padding: 0; max-width: 72ch; }
  .cases li { padding: 20px 0 22px; border-top: 1px solid var(--hair); }
  .cases li:last-child { border-bottom: 1px solid var(--hair); }
  .cases a { text-decoration: none; }
  .name { font: expanded var(--head-weight) clamp(19px, 1.8vw, 23px)/1.3 var(--font-head); }
  .cases a:hover .name, .site a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .22em; }
  .cases svg { width: 14px; height: 14px; margin-left: 10px; vertical-align: baseline; transition: transform .25s var(--ease); }
  .cases a:hover svg { transform: translateX(3px); }
  .cases p { margin: 8px 0 0; color: var(--ink-2); max-width: 62ch; text-wrap: pretty; }
  .cases li.site { padding: 14px 0 16px; }
  .site a { font: 600 16px/1.3 var(--font-label); }
  .site svg { width: 12px; height: 12px; }
  /* Wide screens: name and summary side by side, so the list uses the full measure. */
  @media (min-width: 881px) {
    .cases { max-width: none; }
    .cases li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 0 32px; align-items: baseline; }
    .cases a { justify-self: start; }
    .cases li:last-child { border-bottom: 0; } /* the section rule closes the list */
    .cases p { margin: 0; }
  }
</style>
