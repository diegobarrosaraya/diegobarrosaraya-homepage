---
import type { ServiceRecord, WorkArea } from '../data/work';
export interface Props { records: Array<{ area: WorkArea; record: ServiceRecord; ref: string }> }
const { records } = Astro.props;
---
<table class="records">
  <thead>
    <tr>
      <th class="label" scope="col">Ref</th><th class="label" scope="col">Work</th><th class="label" scope="col">Constraint</th>
      <th class="label" scope="col">Safeguard</th><th class="label" scope="col">Result</th>
    </tr>
  </thead>
  <tbody>
    {records.map(({ area, record, ref }) => (
      <tr data-part={area.part}>
        <td class="mono">{ref}</td>
        <td class="title"><a href={`/work/${area.slug}/${record.slug}/`}>{record.name}</a></td>
        <td data-k="Constraint">{record.constraint}</td>
        <td data-k="Safeguard">{record.safeguard}</td>
        <td data-k="Result">{record.result}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .records { width: 100%; border-collapse: collapse; }
  th { text-align: left; color: var(--ink-2); padding: 0 16px 10px 0; border-bottom: 1px solid var(--rule); }
  td { padding: 14px 16px 14px 0; border-bottom: 1px solid var(--hair); vertical-align: top; }
  td:first-child { width: 5.5em; color: var(--ink-2); }
  td.title a { font-weight: 600; }
  @media (max-width: 880px) {
    thead { display: none; }
    .records, tbody, tr, td { display: block; width: 100%; }
    tr { padding: 12px 0; border-bottom: 1px solid var(--hair); }
    td { border: 0; padding: 2px 0; }
    td[data-k]::before {
      content: attr(data-k) "  "; font: 600 12px var(--font-label); letter-spacing: .09em;
      text-transform: uppercase; color: var(--ink-2);
    }
  }
</style>
