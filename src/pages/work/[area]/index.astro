---
// DRAFT: Diego reviews
import Sheet from '../../../layouts/Sheet.astro';
import Movement from '../../../components/Movement.astro';
import AreaDetail from '../../../components/AreaDetail.astro';
import { AREAS } from '../../../data/work';

export const getStaticPaths = () => AREAS.map((area) => ({ params: { area: area.slug }, props: { area } }));
const { area } = Astro.props;
---
<Sheet title={`${area.title} | Diego Barros Araya`} description={area.lede} current="work">
  <div class="hero">
    <Movement focus={area.slug} />
    <AreaDetail area={area} />
  </div>
</Sheet>
