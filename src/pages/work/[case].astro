---
import Sheet from '../../layouts/Sheet.astro';
import { CASES } from '../../data/story';

export const getStaticPaths = () => CASES.map((study) => ({ params: { case: study.slug }, props: { study } }));
const { study } = Astro.props;
const sections = [
  ['The constraint', study.constraint], ['The decision', study.decision], ['The safeguard', study.safeguard],
  ['The result', study.result], ['The trade-off', study.tradeoff],
] as const;
---
<Sheet title={`${study.name} | Diego Barros Araya`} description={study.summary} current="work">
  <article class="block">
    <a class="back" href="/#work">
      <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 7H2M6 3 2 7l4 4" /></svg>
      All work</a>
    <h1>{study.name}</h1>
    <p class="lede">{study.summary}</p>
    {sections.map(([heading, text]) => (
      <section><h2>{heading}</h2><p>{text}</p></section>
    ))}
    <p class="repo"><a class="btn" href={study.repo}>Source on GitHub</a></p>
  </article>
</Sheet>

<style>
  .back {
    color: var(--steel); font: 600 15px/1 var(--font-label);
    display: inline-flex; gap: 8px; align-items: center;
  }
  h1 { font: 400 clamp(23px, 2.5vw, 34px)/1.25 var(--font-head); margin: 28px 0 10px; text-wrap: balance; }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0 0 22px; max-width: 52ch; }
  section { border-top: 1px solid var(--hair); padding: 14px 0; max-width: 62ch; }
  section:last-of-type { border-bottom: 1px solid var(--hair); }
  h2 { font: 600 17px/1.3 var(--font-label); margin: 0 0 6px; }
  section p { margin: 0; }
  .repo { margin: 22px 0 0; }
  /* Wide screens: heading beside its text, like the home page sections. */
  @media (min-width: 881px) {
    section { display: grid; grid-template-columns: 12rem minmax(0, 62ch); column-gap: 40px; max-width: none; padding: 18px 0; }
    h2 { margin: 0; }
  }
</style>
