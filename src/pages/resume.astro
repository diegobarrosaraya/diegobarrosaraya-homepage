---
// DRAFT: Diego reviews. Reads public/resume.json at build time. Certificates are shown as listed; Diego decides which to keep.
import { readFileSync } from 'node:fs';
import Sheet from '../layouts/Sheet.astro';

const r = JSON.parse(readFileSync('public/resume.json', 'utf8'));
const span = (a: { startDate?: string; endDate?: string }) => `${a.startDate ?? ''} to ${a.endDate ?? 'present'}`;
const sections = [
  { id: 'work', title: 'Experience', rows: r.work.map((w: any) => [w.position, `${w.name}, ${w.location}`, span(w), w.summary]) },
  { id: 'edu', title: 'Education', rows: r.education.map((e: any) => [`${e.studyType}, ${e.area}`, `${e.institution}, ${e.location}`, span(e), '']) },
  { id: 'certs', title: 'Certificates', rows: r.certificates.map((c: any) => [c.name, '', `${c.date}${c.expires ? ` to ${c.expires}` : ''}`, '']) },
];
---
<Sheet title="Resume | Diego Barros Araya" description={r.basics.summary} current="resume">
  <header class="title">
    <h1>{r.basics.name}</h1>
    <p class="lede">{r.basics.label}</p>
  </header>
  <section class="block" aria-labelledby="spec-h">
    <h2 id="spec-h"><span class="mono">01</span>Specification</h2>
    <table aria-label="Specification">
      <tr><th class="label" scope="row">Summary</th><td>{r.basics.summary}</td></tr>
      <tr><th class="label" scope="row">Base</th><td>{r.basics.location.city}, {r.basics.location.region}</td></tr>
      <tr><th class="label" scope="row">Languages</th><td>{r.languages.map((l: any) => `${l.language} (${l.fluency})`).join(', ')}</td></tr>
    </table>
    <p class="actions"><a class="btn primary" href="/resume.pdf">Resume PDF</a></p>
  </section>

  {sections.map((s, i) => (
    <section class="block" id={s.id} aria-labelledby={`${s.id}-h`}>
      <h2 id={`${s.id}-h`}><span class="mono">{String(i + 2).padStart(2, '0')}</span>{s.title}</h2>
      <ul>
        {s.rows.map(([title, where, when, text]: string[]) => (
          <li><div><strong>{title}</strong>{where && <div class="sub">{where}</div>}{text && <p>{text}</p>}</div><span class="mono when">{when}</span></li>
        ))}
      </ul>
    </section>
  ))}

  <section class="block" id="skills" aria-labelledby="skills-h">
    <h2 id="skills-h"><span class="mono">05</span>Skills</h2>
    <table aria-label="Skills">
      {r.skills.map((s: any) => <tr><th class="label" scope="row">{s.name}</th><td>{s.keywords.join(', ')}</td></tr>)}
    </table>
  </section>
</Sheet>

<style>
  h1 { font: 700 clamp(30px, 3.4vw, 44px)/1.05 var(--font-label); margin: 0 0 8px; text-wrap: balance; }
  .title { padding-top: 34px; }
  .lede { color: var(--ink-2); margin: 0; }
  table { width: 100%; max-width: 62ch; border-collapse: collapse; }
  th, td { text-align: left; vertical-align: top; padding: 10px 0; border-top: 1px solid var(--hair); }
  th { width: 9.5em; padding-right: 14px; color: var(--ink-2); line-height: 1.55; }
  tr:last-child th, tr:last-child td { border-bottom: 1px solid var(--hair); }
  .actions { margin: 22px 0 0; }
  ul { list-style: none; margin: 0; padding: 0; max-width: 62ch; }
  li { border-top: 1px solid var(--hair); padding: 12px 0; display: flex; justify-content: space-between; gap: 14px; }
  li:last-child { border-bottom: 1px solid var(--hair); }
  .sub { color: var(--ink-2); }
  li p { margin: 6px 0 0; }
  .when { color: var(--ink-2); white-space: nowrap; }
  @media (max-width: 560px) { li { flex-direction: column; gap: 4px; } }
</style>
