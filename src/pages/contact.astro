---
// DRAFT: Diego reviews.
import Sheet from '../layouts/Sheet.astro';
const rows = [
  ['Email', 'mailto:contact@diegobarrosaraya.com', 'contact@diegobarrosaraya.com'],
  ['GitHub', 'https://github.com/DiegoBarrosA', 'github.com/DiegoBarrosA'],
  ['LinkedIn', 'https://linkedin.com/in/diegobarrosaraya', 'linkedin.com/in/diegobarrosaraya'],
];
---
<Sheet title="Contact | Diego Barros Araya" description="How to reach Diego Barros Araya." current="contact">
  <section class="block" aria-labelledby="c-h">
    <h1 id="c-h"><span class="mono">01</span>Contact <small>Email is quickest.</small></h1>
    <table aria-label="Contact">
      {rows.map(([k, href, text]) => <tr><th class="label" scope="row">{k}</th><td><a href={href}>{text}</a></td></tr>)}
    </table>
  </section>
</Sheet>

<style>
  table { width: 100%; max-width: 62ch; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 0; border-top: 1px solid var(--hair); }
  th { width: 9.5em; color: var(--ink-2); }
  tr:last-child th, tr:last-child td { border-bottom: 1px solid var(--hair); }
</style>
