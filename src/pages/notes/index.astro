---
import Sheet from '../../layouts/Sheet.astro';
import NoteList from '../../components/NoteList.astro';
import { allNotes } from '../../lib/notes/collection';

const notes = await allNotes();
---
<Sheet current="notes" title="Notes | Diego Barros Araya" description="Notes and guides from my own work, newest first.">
  <Fragment slot="head">
    {notes.length === 0 && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title="Notes" href="/notes/rss.xml" />
  </Fragment>
  <div class="intro">
    <h1>Notes</h1>
    {notes.length === 0 ? (
      <p class="lede">No notes yet.</p>
    ) : (
      <p class="lede">Notes and guides from my own work, newest first. Also as an <a href="/notes/rss.xml">RSS feed</a>.</p>
    )}
  </div>
  {notes.length > 0 && (
    <section class="block" aria-label="All notes">
      <NoteList notes={notes} />
    </section>
  )}
</Sheet>

<style>
  .intro { padding: 34px 0 30px; border-bottom: 1px solid var(--rule); }
  .intro:has(+ .block) { border-bottom: 0; } /* the list draws its own top rule */
  .intro:last-child { border-bottom: 0; } /* no notes: the footer rule closes the page */
  h1 { font: expanded var(--head-weight) clamp(23px, 2.5vw, 34px)/1.25 var(--font-head); margin: 0 0 10px; text-wrap: balance; }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0; max-width: 52ch; text-wrap: pretty; }
</style>
