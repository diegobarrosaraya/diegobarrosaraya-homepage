---
import { render } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';
import { noteEntries } from '../../lib/notes/collection';

export async function getStaticPaths() {
  const entries = await noteEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { title, description, tags, created, updated } = entry.data;
const { Content } = await render(entry);
---
<Sheet current="notes" title={`${title} | Diego Barros Araya`} description={description}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Notes" href="/notes/rss.xml" />
  </Fragment>
  <article class="note">
    <a class="back" href="/notes/">
      <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 7H2M6 3 2 7l4 4" /></svg>
      All notes</a>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <p class="meta">
      Updated <time datetime={updated}>{updated}</time>
      {created && created !== updated && <>, first written <time datetime={created}>{created}</time></>}
      {tags.length > 0 && <> · {tags.map((t, i) => <>{i > 0 && ', '}{t}</>)}</>}
    </p>
    <div class="prose"><Content /></div>
  </article>
</Sheet>

<style>
  .note { padding-bottom: 34px; }
  .back {
    color: var(--steel); font: 600 15px/1 var(--font-label);
    display: inline-flex; gap: 8px; align-items: center; margin-top: 28px;
  }
  h1 { font: expanded var(--head-weight) clamp(23px, 2.5vw, 34px)/1.25 var(--font-head); margin: 22px 0 10px; max-width: 30ch; text-wrap: balance; }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0 0 14px; max-width: 52ch; text-wrap: pretty; }
  .meta { font-size: 15px; color: var(--ink-2); margin: 0; padding-bottom: 22px; border-bottom: 1px solid var(--hair); }

  /* Reading text from the notes collection: one measure, Archivo for headings, Barlow for the rest. */
  .prose { padding-top: 6px; overflow-wrap: break-word; }
  .prose > :global(:not(.diagram)) { max-width: 68ch; }
  .prose :global(:is(p, ul, ol, table, pre, aside, blockquote, figure)) { margin: 0 0 18px; }
  .prose :global(:is(h2, h3)) { font-family: var(--font-head); font-stretch: expanded; font-weight: var(--head-weight); text-wrap: balance; }
  .prose :global(h2) { font-size: 20px; line-height: 1.3; margin: 34px 0 12px; }
  .prose :global(h3) { font-size: 17px; line-height: 1.3; margin: 26px 0 10px; }
  .prose :global(:is(h4, h5, h6)) { font: 600 17px/1.3 var(--font-label); margin: 22px 0 8px; }
  .prose :global(:is(ul, ol)) { padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 4px; }
  .prose :global(li > :is(ul, ol)) { margin: 4px 0 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--hair); margin: 30px 0; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(blockquote) { margin-left: 0; padding-left: 16px; border-left: 1px solid var(--hair); color: var(--ink-2); }

  /* Code: real identifiers and commands, so mono. Colours come from the theme tokens (see astro.config.ts). */
  .prose :global(code) { font-family: var(--font-mono); font-size: .86em; }
  .prose :global(:not(pre) > code) { background: var(--plate); padding: 1px 5px; }
  .prose :global(pre) { padding: 14px 16px; border: 1px solid var(--hair); overflow-x: auto; line-height: 1.5; font-size: 15px; }
  .prose :global(pre code) { font-size: 14px; }

  .prose :global(table) { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 16px; }
  .prose :global(:is(th, td)) { text-align: left; vertical-align: top; padding: 9px 16px 9px 0; border-top: 1px solid var(--hair); }
  .prose :global(tr:last-child td) { border-bottom: 1px solid var(--hair); }
  .prose :global(th) { font-weight: 600; color: var(--ink-2); }

  /* Callouts: a quiet aside, hairline frame, the type or title as a plain line of text. */
  .prose :global(.callout) { border: 1px solid var(--hair); padding: 14px 18px; }
  .prose :global(.callout > :last-child) { margin-bottom: 0; }
  .prose :global(.callout-title) { font-weight: 600; margin-bottom: 6px; }
  .prose :global(.callout-title + *) { margin-top: 0; }

  /* Mermaid diagrams arrive as inline SVG with fixed colours; repaint them from the tokens so they read in both views. */
  /* A diagram may use the full sheet width and scrolls sideways on a phone (see rehype-diagram-frame.ts). */
  /* Edge shadows appear only while there is more to scroll to, so a cut-off diagram reads as scrollable. */
  .prose :global(.diagram) {
    overflow-x: auto; margin: 0;
    background:
      linear-gradient(to right, var(--ground) 30%, transparent) left center / 36px 100% no-repeat local,
      linear-gradient(to left, var(--ground) 30%, transparent) right center / 36px 100% no-repeat local,
      linear-gradient(to right, color-mix(in srgb, var(--ink) 28%, transparent), transparent) left center / 14px 100% no-repeat scroll,
      linear-gradient(to left, color-mix(in srgb, var(--ink) 28%, transparent), transparent) right center / 14px 100% no-repeat scroll;
  }
  .prose :global(.diagram:focus-visible) { outline: 2px solid var(--steel); outline-offset: 2px; }
  .prose :global(.diagram > svg) { display: block; height: auto; }
  .prose :global(svg[id^="mermaid"] :is(text, tspan)) { fill: var(--ink) !important; font-family: var(--font-body) !important; }
  .prose :global(svg[id^="mermaid"] :is(foreignObject div, foreignObject span, foreignObject p)) { color: var(--ink) !important; font-family: var(--font-body) !important; }
  /* Shapes: inside a flowchart or class node, or the shape itself carries the class (sequence actors, notes, loop labels). */
  .prose :global(svg[id^="mermaid"] :is(.node, .cluster, .actor-man) :is(rect, circle, ellipse, polygon, path)),
  .prose :global(svg[id^="mermaid"] :is(rect, circle, ellipse, polygon, path):is(.actor, .actor-top, .actor-bottom, .actor-box, .note, .labelBox)) { fill: var(--plate) !important; stroke: var(--ink) !important; }
  .prose :global(svg[id^="mermaid"] :is(.flowchart-link, .edgePath path, .messageLine0, .messageLine1, .relation, .transition, line)) { stroke: var(--ink) !important; }
  .prose :global(svg[id^="mermaid"] :is(marker path, .arrowheadPath, .arrowMarkerPath)) { fill: var(--ink) !important; stroke: var(--ink) !important; }
  .prose :global(svg[id^="mermaid"] :is(.edgeLabel, .labelBkg, .edgeLabel p, .edgeLabel rect)) { background-color: var(--ground) !important; fill: var(--ground) !important; opacity: 1 !important; }
</style>
