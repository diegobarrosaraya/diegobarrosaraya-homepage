---
import { fade } from 'astro:transitions';
import Sheet from '../layouts/Sheet.astro';
import Movement from '../components/Movement.astro';
import CaseStudyList from '../components/CaseStudyList.astro';
import NoteList from '../components/NoteList.astro';
import { allNotes } from '../lib/notes/collection';
import { HOME, PRINCIPLES } from '../data/story';

// The newest three notes. With no notes, the section, the header item and the link in the teams line all drop out.
const notes = await allNotes();
const latest = notes.slice(0, 3);
const linkWord = 'guides';

const contact = [
  ['Email', 'mailto:contact@diegobarrosaraya.com', 'contact@diegobarrosaraya.com'],
  ['GitHub', 'https://github.com/diegobarrosaraya', 'github.com/diegobarrosaraya'],
  ['LinkedIn', 'https://linkedin.com/in/diegobarrosaraya', 'linkedin.com/in/diegobarrosaraya'],
  ['Resume', '/resume.pdf', 'Resume PDF'],
];
---
<Sheet title="Diego Barros Araya" description="Platform and developer-tooling engineer in Santiago, Chile.">
  <div class="hero">
    <Movement />
    <div class="spec" transition:name="detail" transition:animate={fade({ duration: '450ms' })}>
      <h1>{HOME.headline}</h1>
      <p class="lede">{HOME.lede}</p>
      <div class="actions">
        <a class="btn primary" href="#work">Read the case studies
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" /></svg></a>
        <a class="btn" href="/resume.pdf">Resume PDF
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 2v8M3.5 6.5 7 10l3.5-3.5M2 12.5h10" /></svg></a>
      </div>
    </div>
  </div>

  <section class="block" aria-labelledby="at-h">
    <h2 id="at-h">At work</h2>
    <p class="statement">{HOME.atWork}</p>
  </section>

  <section class="block" id="team" aria-labelledby="team-h">
    <h2 id="team-h">Working with teams</h2>
    {HOME.team.map((line) => {
      // The word "guides" links to the notes; the text of the line is the same either way.
      const at = notes.length > 0 ? line.indexOf(linkWord) : -1;
      return at === -1
        ? <p class="line">{line}</p>
        : <p class="line">{line.slice(0, at)}<a href="/notes/">{linkWord}</a>{line.slice(at + linkWord.length)}</p>;
    })}
    <p class="close">{HOME.teamClose}</p>
  </section>

  <section class="block" id="work" aria-labelledby="work-h">
    <h2 id="work-h">Case studies</h2>
    <CaseStudyList />
  </section>

  <section class="block" id="path" aria-labelledby="path-h">
    <h2 id="path-h">How I got here</h2>
    <p class="statement">{HOME.path}</p>
  </section>

  <section class="block" id="how" aria-labelledby="how-h">
    <h2 id="how-h">How I work</h2>
    <ul class="principles">
      {PRINCIPLES.map((p) => <li><a href={`/how/${p.slug}/`}>{p.sentence}</a></li>)}
    </ul>
  </section>

  {latest.length > 0 && (
    <section class="block" id="notes" aria-labelledby="notes-h">
      <h2 id="notes-h">Latest notes</h2>
      <NoteList notes={latest} />
      <p class="all"><a href="/notes/">All notes</a></p>
    </section>
  )}

  <section class="block" id="contact"aria-labelledby="contact-h">
    <h2 id="contact-h">Contact</h2>
    <dl class="contact">
      {contact.map(([k, href, text]) => <div><dt>{k}</dt><dd><a href={href}>{text}</a></dd></div>)}
    </dl>
  </section>
</Sheet>

<style>
  .spec h1 {
    font: expanded var(--head-weight) clamp(23px, 2.5vw, 34px)/1.25 var(--font-head); letter-spacing: 0;
    margin: 0 0 14px; text-wrap: balance;
  }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0 0 22px; max-width: 46ch; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  /* Phones: the headline comes before the drawing. */
  @media (max-width: 880px) { .spec { order: -1; } }

  .statement { font-size: clamp(20px, 1.9vw, 24px); line-height: 1.45; margin: 0; max-width: 40ch; text-wrap: pretty; }
  .line { font-size: 19px; margin: 0 0 12px; max-width: 58ch; text-wrap: pretty; }
  .close { margin: 22px 0 0; color: var(--ink-2); max-width: 58ch; text-wrap: pretty; }

  .principles { list-style: none; margin: 0; padding: 0; max-width: 62ch; }
  .principles li { border-top: 1px solid var(--hair); }
  .principles li:last-child { border-bottom: 1px solid var(--hair); }
  .principles a { display: block; padding: 14px 0; font-size: 19px; text-decoration: none; }
  .principles a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .22em; }

  .all { margin: 14px 0 0; font-size: 19px; }

  .contact { margin: 0; max-width: 62ch; }
  .contact div { display: grid; grid-template-columns: 7em 1fr; gap: 14px; padding: 10px 0; border-top: 1px solid var(--hair); }
  .contact div:last-child { border-bottom: 1px solid var(--hair); }
  /* Phones: a narrower label column leaves the email and LinkedIn values one line. */
  @media (max-width: 560px) { .contact div { grid-template-columns: 4.5em 1fr; } .contact dd { font-size: 16px; } }
  .contact dt { color: var(--ink-2); }
  .contact dd { margin: 0; overflow-wrap: anywhere; }

  /* Wide screens: section heading in a label column, content across the rest of the sheet. */
  @media (min-width: 881px) {
    .block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); column-gap: 40px; align-items: start; }
    .block > h2 { grid-column: 1; grid-row: 1 / span 3; margin: 0; padding-top: 4px; }
    .block > :not(h2) { grid-column: 2; }
    .principles { max-width: none; display: grid; grid-template-columns: 1fr 1fr; grid-auto-flow: column; grid-template-rows: repeat(3, auto); column-gap: 32px; }
    /* The section rule closes the list; no second rule just above it. */
    .principles li:last-child { border-bottom: 0; }
    .spec { align-self: center; }
  }
</style>
