---
// DRAFT: Diego reviews the headline, lede and parts list line.
import { fade } from 'astro:transitions';
import Sheet from '../layouts/Sheet.astro';
import Movement from '../components/Movement.astro';
import SpecTable from '../components/SpecTable.astro';
import RecordsTable from '../components/RecordsTable.astro';
import { AREAS, recordRef } from '../data/work';

const records = AREAS.flatMap((area) => area.records.map((record, i) => ({ area, record, ref: recordRef(area, i) })));
---
<Sheet title="Diego Barros Araya" description="Platform and developer-tooling engineer in Santiago, Chile.">
  <div class="hero" id="work">
    <Movement />
    <div class="spec" transition:name="detail" transition:animate={fade({ duration: '450ms' })}>
      <h1>I build systems that are safe to run, inside the constraints they come with.</h1>
      <p class="lede">Platform and developer-tooling engineer in Santiago. Integrations, automation and backends, shipped carefully and adapted fast.</p>
      <SpecTable />
      <div class="actions">
        <a class="btn primary" href="#records">Read the service records
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" /></svg></a>
        <a class="btn" href="/resume.pdf">Resume PDF
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 2v8M3.5 6.5 7 10l3.5-3.5M2 12.5h10" /></svg></a>
      </div>
    </div>
  </div>

  <section class="block" id="records" aria-labelledby="rec-h">
    <h2 id="rec-h"><span class="mono">02</span>Service records <small>Each one: the constraint, what kept it safe, what came out.</small></h2>
    <RecordsTable records={records} />
  </section>

  <section class="block" id="parts" aria-labelledby="parts-h">
    <h2 id="parts-h"><span class="mono">03</span>Parts list</h2>
    <p class="soon">Short notes on things I learned along the way. The first ones arrive here soon.</p>
  </section>
</Sheet>

<style>
  .spec h1 {
    font: 700 clamp(30px, 3.4vw, 44px)/1.05 var(--font-label); letter-spacing: -.005em;
    margin: 0 0 6px; text-wrap: balance;
  }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0 0 22px; max-width: 46ch; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .soon { margin: 0; color: var(--ink-2); }
</style>
